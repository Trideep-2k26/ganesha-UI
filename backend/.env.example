# Backend configuration
# Copy to .env and fill in as needed

# TTS Provider: edge-tts (online, free, Indian neural voices) or pyttsx3 (offline)
# Default: edge-tts
TTS_PROVIDER=edge-tts

# Edge recommended voices per language (male defaults):
# hi -> hi-IN-MadhurNeural | en -> en-IN-PrabhatNeural | ta -> ta-IN-ValluvarNeural | te -> te-IN-MohanNeural
# bn -> bn-IN-BashkarNeural | gu -> gu-IN-NiranjanNeural | mr -> mr-IN-ManoharNeural | kn -> kn-IN-GaganNeural
# ml -> ml-IN-MidhunNeural | pa -> pa-IN-GurpreetNeural
# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# LLM Provider: mistral or openai
LLM_PROVIDER=mistral

# Mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# OpenAI (optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o


